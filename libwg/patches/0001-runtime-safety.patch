 	}
 	err = unix.IoctlSetInt(ioctlFD, unix.SIOCSIFADDR, toInt(&req))
 	if err != nil {
-		println(err.Error())
-		panic(err)
+		return fmt.Errorf("failed to set IPv4 address: %w", err)
 	}
 	return nil
 }
 
+// CloseInterfaceResources releases the process-wide Darwin ioctl descriptor
+// and forgets address state so repeated start/stop cycles cannot reuse stale
+// interface data.
+func CloseInterfaceResources() {
+	if ioctlFD != 0 {
+		_ = unix.Close(ioctlFD)
+		ioctlFD = 0
+	}
+	interfaceIP = nil
+	interfaceIPv6 = nil
+}
+
 func toInt(data any) int {
 	v := reflect.ValueOf(data)
 	return int(v.Pointer())
