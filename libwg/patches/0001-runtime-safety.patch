@@ -0,0 +1,17 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestUnavailableUAPIIsExplicit(t *testing.T) {
+	if response := unavailableUAPI(); !strings.Contains(response, "errno=") {
+		t.Fatalf("expected an errno response, got %q", response)
+	}
+}
+
+func TestStopWgIsIdempotent(t *testing.T) {
+	stopWg()
+	stopWg()
+}
