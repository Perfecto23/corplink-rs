diff --git a/conn/bind_tcp_burst_test.go b/conn/bind_tcp_burst_test.go
new file mode 100644
--- /dev/null
+++ b/conn/bind_tcp_burst_test.go
@@ -0,0 +1,71 @@
+package conn
+
+import (
+	"bytes"
+	"encoding/binary"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestTCPBindPreservesBurstPayloads(t *testing.T) {
+	server, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+	bind := NewTCPBind()
+	receivers, _, err := bind.Open(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer bind.Close()
+	endpoint, err := bind.ParseEndpoint(server.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() {
+		c, e := server.Accept()
+		if e != nil {
+			done <- e
+			return
+		}
+		defer c.Close()
+		c.SetDeadline(time.Now().Add(10 * time.Second))
+		trigger := make([]byte, 5)
+		if _, e = io.ReadFull(c, trigger); e != nil {
+			done <- e
+			return
+		}
+		for i := 0; i < 128; i++ {
+			data := bytes.Repeat([]byte{byte(i)}, 60000)
+			var h [4]byte
+			binary.LittleEndian.PutUint32(h[:], uint32(len(data)))
+			if _, e = c.Write(append(h[:], data...)); e != nil {
+				done <- e
+				return
+			}
+		}
+		done <- nil
+	}()
+	if err = bind.Send([][]byte{{1}}, endpoint); err != nil {
+		t.Fatal(err)
+	}
+	buffers := [][]byte{make([]byte, 65535)}
+	sizes := make([]int, 1)
+	eps := make([]Endpoint, 1)
+	for i := 0; i < 128; i++ {
+		n, e := receivers[0](buffers, sizes, eps)
+		if e != nil {
+			t.Fatal(e)
+		}
+		if n != 1 || sizes[0] != 60000 || !bytes.Equal(buffers[0][:sizes[0]], bytes.Repeat([]byte{byte(i)}, 60000)) {
+			t.Fatalf("burst packet %d corrupted", i)
+		}
+	}
+	if err = <-done; err != nil {
+		t.Fatal(err)
+	}
+}
