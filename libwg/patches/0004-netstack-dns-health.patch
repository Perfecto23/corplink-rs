new file mode 100644
--- /dev/null
+++ b/libwg/dns_health.go
@@ -0,0 +1,28 @@
+package main
+
+/*
+typedef const char cchar_t;
+*/
+import "C"
+
+import (
+	"context"
+	"time"
+)
+
+//export probeNetstackDNS
+func probeNetstackDNS(host *C.cchar_t) C.int {
+	runtimeMu.Lock()
+	stack := tnet
+	runtimeMu.Unlock()
+	if stack == nil {
+		return 2
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	addresses, err := stack.LookupContextHost(ctx, C.GoString(host))
+	if err != nil || len(addresses) == 0 {
+		return 1
+	}
+	return 0
+}
