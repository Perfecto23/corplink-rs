--- /dev/null
+++ b/tun/netstack/dns_tcp_test.go
@@ -0,0 +1,96 @@
+package netstack
+
+import (
+	"context"
+	"encoding/binary"
+	"io"
+	"net/netip"
+	"testing"
+	"time"
+
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+func TestTCPDNSWorksWhenUDPIsBlackholed(t *testing.T) {
+	for _, scenario := range []struct {
+		name                     string
+		tcpDNS, primaryBlackhole bool
+	}{
+		{"udp-blackhole", false, false},
+		{"tcp-resolver", true, false},
+		{"tcp-primary-blackhole-backup-healthy", true, true},
+	} {
+		t.Run(scenario.name, func(t *testing.T) {
+			ips := []netip.Addr{netip.MustParseAddr("10.0.0.1")}
+			if scenario.primaryBlackhole {
+				ips = append(ips, netip.MustParseAddr("10.0.0.2"))
+			}
+			dev, stack, err := CreateNetTUN(ips, ips, 1420)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer dev.Close()
+			stack.SetDNSOverTCP(scenario.tcpDNS)
+			for index, ip := range ips {
+				blackhole := scenario.primaryBlackhole && index == 0
+				udp, err := stack.ListenUDPAddrPort(netip.AddrPortFrom(ip, 53))
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer udp.Close()
+				listener, err := stack.ListenTCPAddrPort(netip.AddrPortFrom(ip, 53))
+				if err != nil {
+					t.Fatal(err)
+				}
+				done := make(chan struct{})
+				defer func() { listener.Close(); <-done }()
+				go func() {
+					defer close(done)
+					conn, err := listener.Accept()
+					if err != nil {
+						return
+					}
+					defer conn.Close()
+					conn.SetDeadline(time.Now().Add(3 * time.Second))
+					if blackhole {
+						_, _ = io.Copy(io.Discard, conn)
+						return
+					}
+					var size [2]byte
+					if _, err = io.ReadFull(conn, size[:]); err != nil {
+						return
+					}
+					request := make([]byte, binary.BigEndian.Uint16(size[:]))
+					if _, err = io.ReadFull(conn, request); err != nil {
+						return
+					}
+					var response dnsmessage.Message
+					if response.Unpack(request) != nil {
+						return
+					}
+					response.Header.Response = true
+					response.Answers = []dnsmessage.Resource{{
+						Header: dnsmessage.ResourceHeader{Name: response.Questions[0].Name, Type: dnsmessage.TypeA, Class: dnsmessage.ClassINET},
+						Body:   &dnsmessage.AResource{A: [4]byte{192, 0, 2, 5}},
+					}}
+					packet, err := response.Pack()
+					if err != nil {
+						return
+					}
+					binary.BigEndian.PutUint16(size[:], uint16(len(packet)))
+					conn.Write(append(size[:], packet...))
+				}()
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			defer cancel()
+			addresses, err := stack.LookupContextHost(ctx, "example.test")
+			if !scenario.tcpDNS {
+				if err == nil {
+					t.Fatal("UDP blackhole unexpectedly resolved")
+				}
+			} else if err != nil || len(addresses) != 1 || addresses[0] != "192.0.2.5" {
+				t.Fatalf("TCP DNS failed: %v %v", addresses, err)
+			}
+		})
+	}
+}
