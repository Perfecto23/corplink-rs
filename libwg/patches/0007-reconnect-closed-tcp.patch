diff --git a/conn/bind_tcp_reconnect_test.go b/conn/bind_tcp_reconnect_test.go
new file mode 100644
--- /dev/null
+++ b/conn/bind_tcp_reconnect_test.go
@@ -0,0 +1,156 @@
+package conn
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestTCPBindReopensAfterReadAndWriteFailure(t *testing.T) {
+	for _, failedWrite := range []bool{false, true} {
+		name := "peer-eof"
+		if failedWrite {
+			name = "write-error"
+		}
+		t.Run(name, func(t *testing.T) {
+			listener, err := net.ListenTCP("tcp", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer listener.Close()
+			listener.SetDeadline(time.Now().Add(5 * time.Second))
+			bind := NewTCPBind().(*TcpBind)
+			if _, _, err = bind.Open(0); err != nil {
+				t.Fatal(err)
+			}
+			defer bind.Close()
+			endpoint, err := bind.ParseEndpoint(listener.Addr().String())
+			if err != nil {
+				t.Fatal(err)
+			}
+			old, err := net.DialTCP("tcp", nil, listener.Addr().(*net.TCPAddr))
+			if err != nil {
+				t.Fatal(err)
+			}
+			remote, err := listener.AcceptTCP()
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer remote.Close()
+			bind.tcpConnMap.Store(endpoint.DstToString(), old)
+			if failedWrite {
+				old.Close()
+				if bind.Send([][]byte{{1}}, endpoint) == nil {
+					t.Fatal("closed writer must fail")
+				}
+			} else {
+				bind.handleConn(old, endpoint)
+				remote.Close()
+			}
+			deadline := time.Now().Add(time.Second)
+			for {
+				if _, exists := bind.tcpConnMap.Load(endpoint.DstToString()); !exists {
+					break
+				}
+				if time.Now().After(deadline) {
+					t.Fatal("failed connection remained cached")
+				}
+				time.Sleep(time.Millisecond)
+			}
+			if err := bind.Send([][]byte{{2}}, endpoint); err != nil {
+				t.Fatal(err)
+			}
+			replacement, err := listener.AcceptTCP()
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer replacement.Close()
+			replacement.SetDeadline(time.Now().Add(time.Second))
+			frame := make([]byte, 5)
+			if _, err = io.ReadFull(replacement, frame); err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(frame, []byte{1, 0, 0, 0, 2}) {
+				t.Fatalf("bad replacement frame: %x", frame)
+			}
+			// Simulate the old reader finishing after the write path redialed.
+			bind.forgetConn(endpoint, old)
+			if current, ok := bind.tcpConnMap.Load(endpoint.DstToString()); !ok || current == old {
+				t.Fatal("late cleanup removed the replacement")
+			}
+		})
+	}
+}
+
+func TestTCPBindDoesNotRedialAfterClose(t *testing.T) {
+	bind := NewTCPBind().(*TcpBind)
+	if _, _, err := bind.Open(0); err != nil {
+		t.Fatal(err)
+	}
+	if err := bind.Close(); err != nil {
+		t.Fatal(err)
+	}
+	endpoint, err := bind.ParseEndpoint("127.0.0.1:1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = bind.Send([][]byte{{1}}, endpoint); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("closed bind attempted a dial: %v", err)
+	}
+}
+
+func TestTCPBindBlockedWriteExpiresAndEvictsConnection(t *testing.T) {
+	listener, err := net.ListenTCP("tcp", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	bind := NewTCPBind().(*TcpBind)
+	if _, _, err = bind.Open(0); err != nil {
+		t.Fatal(err)
+	}
+	defer bind.Close()
+	endpoint, err := bind.ParseEndpoint(listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	client, err := bind.getConn(endpoint)
+	if err != nil {
+		t.Fatal(err)
+	}
+	server, err := listener.AcceptTCP()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+	client.SetWriteBuffer(1024)
+	server.SetReadBuffer(1024)
+	done := make(chan error, 1)
+	go func() {
+		packet := make([]byte, 60000)
+		for i := 0; i < 128; i++ {
+			if err := bind.Send([][]byte{packet}, endpoint); err != nil {
+				done <- err
+				return
+			}
+		}
+		done <- nil
+	}()
+	select {
+	case err := <-done:
+		var timeout net.Error
+		if !errors.As(err, &timeout) || !timeout.Timeout() {
+			t.Fatalf("blocked write did not time out: %v", err)
+		}
+		if _, present := bind.tcpConnMap.Load(endpoint.DstToString()); present {
+			t.Fatal("timed-out connection still cached")
+		}
+	case <-time.After(8 * time.Second):
+		server.Close()
+		<-done
+		t.Fatal("blocked send exceeded its deadline")
+	}
+}
