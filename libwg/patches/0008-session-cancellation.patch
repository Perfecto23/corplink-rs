+
+func TestStopInterruptsSendHoldingDeviceLockAndDNS(t *testing.T) {
+	listener, err := net.ListenTCP("tcp", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	ip := netip.MustParseAddr("10.0.0.1")
+	tun, stack, err := netstack.CreateNetTUN([]netip.Addr{ip}, []netip.Addr{ip}, 1420)
+	if err != nil {
+		t.Fatal(err)
+	}
+	stack.SetDNSOverTCP(true)
+	dnsListener, err := stack.ListenTCPAddrPort(netip.AddrPortFrom(ip, 53))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer dnsListener.Close()
+	dnsAccepted := make(chan net.Conn, 1)
+	go func() {
+		c, e := dnsListener.Accept()
+		if e == nil {
+			dnsAccepted <- c
+		}
+	}()
+	dnsDone := make(chan error, 1)
+	go func() { _, e := stack.LookupContextHost(context.Background(), "example.test"); dnsDone <- e }()
+	var dnsConn net.Conn
+	select {
+	case dnsConn = <-dnsAccepted:
+		defer dnsConn.Close()
+	case <-time.After(time.Second):
+		t.Fatal("DNS query did not connect")
+	}
+	logger = device.NewLogger(device.LogLevelSilent, "")
+	tcpTransport = conn.NewTCPBind()
+	wgDevice = device.NewDevice(tun, tcpTransport, logger)
+	if err = wgDevice.Up(); err != nil {
+		t.Fatal(err)
+	}
+	defer stopWg()
+	var publicKey device.NoisePublicKey
+	publicKey[0] = 9
+	peer, err := wgDevice.NewPeer(publicKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	endpoint, err := tcpTransport.ParseEndpoint(listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	peer.SetEndpointFromPacket(endpoint)
+	if err = peer.SendBuffers([][]byte{{1}}); err != nil {
+		t.Fatal(err)
+	}
+	server, err := listener.AcceptTCP()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+	server.SetReadBuffer(1024)
+	sending := make(chan error, 1)
+	go func() {
+		for i := 0; i < 2048; i++ {
+			if e := peer.SendBuffers([][]byte{make([]byte, 60000)}); e != nil {
+				sending <- e
+				return
+			}
+		}
+		sending <- nil
+	}()
+	select {
+	case e := <-sending:
+		t.Fatalf("writer stopped before explicit stop: %v", e)
+	case <-time.After(5500 * time.Millisecond):
+	}
+	// A pending peer writer makes a concurrent health read wait behind Send.
+	// Real UAPI reads hold runtimeMu, so stop must cancel transport before it.
+	peerWriter := make(chan struct{})
+	go func() { close(peerWriter); peer.Lock(); peer.Unlock() }()
+	<-peerWriter
+	time.Sleep(20 * time.Millisecond)
+	observedDevice := wgDevice
+	healthStarted, healthDone := make(chan struct{}), make(chan struct{})
+	go func() {
+		runtimeMu.Lock()
+		close(healthStarted)
+		_, _ = observedDevice.IpcGet()
+		runtimeMu.Unlock()
+		close(healthDone)
+	}()
+	<-healthStarted
+	time.Sleep(20 * time.Millisecond)
+	stopped := make(chan struct{})
+	go func() { stopWg(); close(stopped) }()
+	select {
+	case <-stopped:
+	case <-time.After(2 * time.Second):
+		server.Close()
+		t.Fatal("Device.Close blocked behind active send")
+	}
+	select {
+	case <-healthDone:
+	case <-time.After(time.Second):
+		t.Fatal("health reader remained blocked")
+	}
+	select {
+	case <-sending:
+	case <-time.After(time.Second):
+		t.Fatal("sender remained blocked")
+	}
+	select {
+	case e := <-dnsDone:
+		if e == nil {
+			t.Fatal("cancelled DNS returned success")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("DNS outlived stopped session")
+	}
+}
diff --git a/libwg/dns_retry_test.go b/libwg/dns_retry_test.go
new file mode 100644
--- /dev/null
+++ b/libwg/dns_retry_test.go
@@ -0,0 +1,76 @@
+package main
+
+import (
+	"context"
+	"encoding/binary"
+	"golang.org/x/net/dns/dnsmessage"
+	"golang.zx2c4.com/wireguard/tun/netstack"
+	"io"
+	"net/netip"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestSOCKSDNSRetryCanFinishAfterFiveSeconds(t *testing.T) {
+	ip := netip.MustParseAddr("10.0.0.1")
+	tun, stack, err := netstack.CreateNetTUN([]netip.Addr{ip}, []netip.Addr{ip}, 1420)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var closeOnce sync.Once
+	closeTun := func() { closeOnce.Do(func() { _ = tun.Close() }) }
+	defer closeTun()
+	stack.SetDNSOverTCP(true)
+	listener, err := stack.ListenTCPAddrPort(netip.AddrPortFrom(ip, 53))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for attempt := 0; attempt < 2; attempt++ {
+			c, e := listener.Accept()
+			if e != nil {
+				return
+			}
+			c.SetDeadline(time.Now().Add(7 * time.Second))
+			var size [2]byte
+			_, e = io.ReadFull(c, size[:])
+			if e != nil {
+				c.Close()
+				return
+			}
+			q := make([]byte, binary.BigEndian.Uint16(size[:]))
+			_, e = io.ReadFull(c, q)
+			if e != nil {
+				c.Close()
+				return
+			}
+			if attempt == 0 {
+				time.Sleep(5500 * time.Millisecond)
+				c.Close()
+				continue
+			}
+			var message dnsmessage.Message
+			if message.Unpack(q) != nil {
+				c.Close()
+				return
+			}
+			message.Header.Response = true
+			message.Answers = []dnsmessage.Resource{{Header: dnsmessage.ResourceHeader{Name: message.Questions[0].Name, Type: dnsmessage.TypeA, Class: dnsmessage.ClassINET}, Body: &dnsmessage.AResource{A: [4]byte{192, 0, 2, 8}}}}
+			response, _ := message.Pack()
+			binary.BigEndian.PutUint16(size[:], uint16(len(response)))
+			c.Write(append(size[:], response...))
+			c.Close()
+		}
+	}()
+	watchdog := time.AfterFunc(10*time.Second, func() { closeTun(); _ = listener.Close() })
+	defer watchdog.Stop()
+	_, resolved, err := (netstackResolver{tnet: stack}).Resolve(context.Background(), "example.test")
+	if err != nil || resolved.String() != "192.0.2.8" {
+		t.Fatalf("valid delayed lookup rejected: %v %v", resolved, err)
+	}
+	<-done
+}
diff --git a/tun/netstack/dns_latency_test.go b/tun/netstack/dns_latency_test.go
new file mode 100644
--- /dev/null
+++ b/tun/netstack/dns_latency_test.go
@@ -0,0 +1,69 @@
+package netstack
+
+import (
+	"context"
+	"encoding/binary"
+	"golang.org/x/net/dns/dnsmessage"
+	"io"
+	"net/netip"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestHealthyDNSReplySurvivesTunnelLatency(t *testing.T) {
+	ips := []netip.Addr{netip.MustParseAddr("10.0.0.1"), netip.MustParseAddr("10.0.0.2")}
+	dev, stack, err := CreateNetTUN(ips, ips, 1420)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer dev.Close()
+	stack.SetDNSOverTCP(true)
+	var workers sync.WaitGroup
+	for _, ip := range ips {
+		listener, err := stack.ListenTCPAddrPort(netip.AddrPortFrom(ip, 53))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer listener.Close()
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			c, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			defer c.Close()
+			c.SetDeadline(time.Now().Add(9 * time.Second))
+			var size [2]byte
+			if _, err = io.ReadFull(c, size[:]); err != nil {
+				return
+			}
+			req := make([]byte, binary.BigEndian.Uint16(size[:]))
+			if _, err = io.ReadFull(c, req); err != nil {
+				return
+			}
+			var response dnsmessage.Message
+			if response.Unpack(req) != nil {
+				return
+			}
+			// Observed healthy tunnel DNS replies arrived after the old five-second limit.
+			time.Sleep(5500 * time.Millisecond)
+			response.Header.Response = true
+			response.Answers = []dnsmessage.Resource{{Header: dnsmessage.ResourceHeader{Name: response.Questions[0].Name, Type: dnsmessage.TypeA, Class: dnsmessage.ClassINET}, Body: &dnsmessage.AResource{A: [4]byte{192, 0, 2, 9}}}}
+			data, err := response.Pack()
+			if err != nil {
+				return
+			}
+			binary.BigEndian.PutUint16(size[:], uint16(len(data)))
+			c.Write(append(size[:], data...))
+		}()
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	addresses, err := stack.LookupContextHost(ctx, "example.test")
+	workers.Wait()
+	if err != nil || len(addresses) != 1 || addresses[0] != "192.0.2.9" {
+		t.Fatalf("discarded valid delayed answer: %v %v", addresses, err)
+	}
+}
