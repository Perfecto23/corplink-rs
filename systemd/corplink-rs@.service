[Unit]
Description=Corplink client written in Rust
Documentation=https://github.com/Perfecto23/corplink-rs
StartLimitIntervalSec=300s
StartLimitBurst=3
After=network.target

[Service]
WorkingDirectory=/etc/corplink
Type=simple
ExecStart=/usr/bin/corplink-rs /etc/corplink/%i.json
KillSignal=SIGINT
# Handled failures exit 1 and must stay stopped; panic exits and abnormal
# signals remain eligible for bounded systemd recovery.
Restart=on-failure
RestartPreventExitStatus=1
RestartSec=5s

[Install]
WantedBy=multi-user.target
